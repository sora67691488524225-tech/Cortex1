<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0b1020">
<title>CORTEX 1.0</title>

<script src="https://js.puter.com/v2/"></script>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #090e1b;
  color: #edf3ff;
  font-family: Arial, sans-serif;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

header {
  padding: 18px;
  background: #111a30;
  border-bottom: 1px solid #263454;
}

.logo {
  font-size: 25px;
  font-weight: bold;
  color: #72b7ff;
}

.sub {
  font-size: 12px;
  color: #9aaaca;
  margin-top: 5px;
}

#chat {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  padding-bottom: 180px;
}

.welcome {
  text-align: center;
  padding: 30px 12px;
}

.welcome h1 {
  font-size: 30px;
  margin-bottom: 8px;
}

.welcome p {
  color: #9aaaca;
}

.msg {
  padding: 13px;
  border-radius: 15px;
  margin: 12px 0;
  max-width: 90%;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  line-height: 1.5;
}

.user {
  background: #2456a6;
  margin-left: auto;
}

.ai {
  background: #17223b;
  border: 1px solid #293958;
  margin-right: auto;
}

.who {
  font-size: 11px;
  color: #a9cfff;
  font-weight: bold;
  margin-bottom: 5px;
}

#bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12px;
  background: #111a30;
  border-top: 1px solid #263454;
}

form {
  display: flex;
  gap: 8px;
}

input {
  flex: 1;
  min-width: 0;
  background: #0b1020;
  border: 1px solid #35476a;
  color: white;
  border-radius: 12px;
  padding: 13px;
  font-size: 16px;
}

button {
  background: #3689ed;
  color: white;
  border: 0;
  border-radius: 12px;
  padding: 0 18px;
  font-size: 20px;
  font-weight: bold;
}

button:disabled {
  opacity: 0.5;
}

.status {
  font-size: 12px;
  color: #9cabc7;
  margin-top: 8px;
}

#clear {
  background: transparent;
  color: #9cabc7;
  font-size: 12px;
  padding: 5px;
}
</style>
</head>

<body>

<header>
  <div class="logo">◈ CORTEX 1.0</div>
  <div class="sub">AI ASSISTANT · ONLINE</div>
</header>

<div id="chat">
  <div class="welcome" id="welcome">
    <h1>Привіт! Я CORTEX.</h1>
    <p>Твій помічник зі штучним інтелектом.</p>
  </div>

  <div class="msg ai">
    <div class="who">CORTEX</div>
    Привіт! Напиши мені щось. Спробуємо поспілкуватися!
  </div>
</div>

<div id="bottom">
  <form id="form">
    <input id="input"
      placeholder="Напиши повідомлення..."
      autocomplete="off">
    <button id="send" type="submit">↑</button>
  </form>

  <div class="status" id="status">
    Готовий до роботи
    <button id="clear" type="button">Очистити чат</button>
  </div>
</div>

<script>
const chat = document.getElementById("chat");
const form = document.getElementById("form");
const input = document.getElementById("input");
const send = document.getElementById("send");
const status = document.getElementById("status");
const welcome = document.getElementById("welcome");

let history = [];

function addMessage(text, role) {
  const bubble = document.createElement("div");
  bubble.className = "msg " + role;

  const who = document.createElement("div");
  who.className = "who";
  who.textContent = role === "user" ? "ТИ" : "CORTEX";

  const content = document.createElement("div");
  content.textContent = text;

  bubble.appendChild(who);
  bubble.appendChild(content);
  chat.appendChild(bubble);

  chat.scrollTop = chat.scrollHeight;
  return content;
}

function getAnswerText(result) {
  if (typeof result === "string") return result;

  if (typeof result?.message?.content === "string") {
    return result.message.content;
  }

  if (Array.isArray(result?.message?.content)) {
    return result.message.content
      .map(item => item.text || "")
      .join("");
  }

  if (typeof result?.text === "string") {
    return result.text;
  }

  return "";
}

form.addEventListener("submit", async function(event) {
  event.preventDefault();

  const text = input.value.trim();
  if (!text || send.disabled) return;

  welcome.style.display = "none";
  addMessage(text, "user");

  input.value = "";
  send.disabled = true;
  status.firstChild.textContent = "CORTEX думає... ";

  const reply = addMessage("Готую відповідь...", "ai");

  try {
    if (!window.puter || !puter.ai) {
      throw new Error(
        "Puter.js не завантажився. Перевір інтернет."
      );
    }

    const messages = [
      {
        role: "system",
        content:
          "Ти CORTEX 1.0, корисний AI-помічник. " +
          "Відповідай зрозуміло мовою користувача."
      },
      ...history,
      { role: "user", content: text }
    ];

    const result = await puter.ai.chat(messages);
    const answer = getAnswerText(result).trim();

    if (!answer) {
      throw new Error("ШІ повернув порожню відповідь.");
    }

    reply.textContent = answer;

    history.push(
      { role: "user", content: text },
      { role: "assistant", content: answer }
    );

    if (history.length > 20) {
      history = history.slice(-20);
    }

    status.firstChild.textContent = "Відповідь отримано ";
  } catch (error) {
    reply.textContent =
      "Не вдалося підключити ШІ.\n\n" +
      (error.message || "Невідома помилка") +
      "\n\nПеревір інтернет та авторизацію Puter.";

    status.firstChild.textContent = "Помилка підключення ";
  } finally {
    send.disabled = false;
    input.focus();
    chat.scrollTop = chat.scrollHeight;
  }
});

document.getElementById("clear").addEventListener("click", function() {
  chat.innerHTML = "";
  history = [];

  welcome.style.display = "block";

  addMessage("Чат очищено! Чим можу допомогти?", "ai");

  status.firstChild.textContent = "Готовий до роботи ";
});
</script>

</body>
</html>
